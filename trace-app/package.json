{
  "name": "trace-app",
  "version": "4.3.3",
  "description": "B-TRACE System - Document requirements tracking for birth certificate applications",
  "author": "City Civil Registrar's Office — Iligan",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:vite\"",
    "dev:vite": "vite",
    "dev:server": "node server/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm run dev",
    "electron:dev": "cross-env PORT=3001 ELECTRON_STRICT_PORTS=1 concurrently \"npm run dev:server\" \"npm run dev:vite\" \"wait-on tcp:5174 tcp:3001 && node electron/dev-runner.js\"",
    "electron:build": "node scripts/electron-build.mjs",
    "electron:build:package": "vite build --mode electron && electron-builder",
    "verify:ausf-pdf": "node scripts/verify-ausf-witness-pdf.mjs",
    "electron:start": "electron .",
    "seed:applicants": "node server/factory/seeder.js",
    "export:user-guide-pdf": "node scripts/export-user-guide-pdf.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.0",
    "jszip": "^3.10.1",
    "multer": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.20.0",
    "recharts": "^3.8.1",
    "sql.js": "^1.10.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "png2icons": "^2.0.1",
    "postcss": "^8.4.32",
    "rcedit": "^5.0.2",
    "tailwindcss": "^3.3.6",
    "vite": "^5.0.0",
    "wait-on": "^9.0.4",
    "playwright": "^1.58.2"
  },
  "build": {
    "appId": "com.trace.app",
    "productName": "B-TRACE System",
    "icon": "public/ccro-logo.png",
    "directories": {
      "output": "electron-release"
    },
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "afterPack": "./electron/after-pack-win-icon.cjs",
    "files": [
      "electron/**/*",
      "server/**/*",
      "public/ccro-logo.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true
    }
  }
}
